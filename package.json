{
  "name": "minecraft-texture-editor",
  "version": "0.1.0",
  "description": "Профессиональный редактор текстур для Minecraft ресурс-паков",
  "main": "dist-electron/main.js",
  "type": "module",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && tsc electron/main.ts electron/preload.ts --outDir dist-electron --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck && node scripts/copy-electron-package.cjs && electron .\"",
    "electron:build": "npm run build && tsc electron/main.ts electron/preload.ts --outDir dist-electron --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck && node scripts/copy-electron-package.cjs",
    "electron:build:win": "npm run electron:build && electron-builder --win --publish never",
    "dist:exe": "npm run electron:build:win"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.1",
    "konva": "^9.2.0",
    "react-konva": "^18.2.10",
    "three": "^0.159.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/drei": "^9.88.3",
    "tailwindcss": "^3.3.6",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "lucide-react": "^0.294.0",
    "framer-motion": "^10.16.7",
    "react-colorful": "^5.6.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-virtualized": "^9.22.5",
    "zundo": "^2.2.0",
    "idb-keyval": "^6.2.0",
    "jszip": "^3.10.1",
    "file-saver": "^2.0.5",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.8.1",
    "@types/file-saver": "^2.0.5",
    "@types/react-virtualized": "^9.21.22",
    "typescript": "^5.2.2",
    "terser": "^5.36.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "prettier": "^3.0.3",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "@vitest/coverage-v8": "^0.34.6",
    "playwright": "^1.40.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.minecraft-texture-editor.app",
    "productName": "Minecraft Texture Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/icon.ico",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Texture Editor",
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
